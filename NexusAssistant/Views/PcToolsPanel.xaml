<UserControl x:Class="NexusAssistant.Views.PcToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ToolSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,23"/>
        </Style>
        <Style x:Key="ToolTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="ToolHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,0,7"/>
        </Style>
        <Style x:Key="ToolResult" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="2,5,0,0"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,18">
        <StackPanel>
            <TextBlock Text="Инструменты ПК" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
            <TextBlock Text="Диагностика Windows, настройки игр и быстрые действия." Style="{StaticResource Caption}" Margin="2,0,0,23"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Style="{StaticResource ToolSection}">
                        <TextBlock Text="Датчики и нагрузка" Style="{StaticResource ToolTitle}"/>
                        <WrapPanel>
                            <Button Content="Температуры" Click="Temperatures_Click" Style="{StaticResource Quiet}"/>
                            <Button Content="ЦП, GPU и память" Click="Load_Click" Style="{StaticResource Quiet}"/>
                        </WrapPanel>
                        <ToggleButton x:Name="LiveLoad" Content="Обновлять нагрузку каждые 8 сек"
                                      Checked="LiveLoad_Changed" Unchecked="LiveLoad_Changed" Style="{StaticResource Switch}"/>
                        <TextBlock x:Name="SensorResult" Style="{StaticResource ToolResult}"/>
                        <TextBlock x:Name="LoadResult" Style="{StaticResource ToolResult}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource ToolSection}">
                        <TextBlock Text="Безопасность" Style="{StaticResource ToolTitle}"/>
                        <TextBlock Text="Для проверки на майнеры и стиллеры используется Защитник Windows." Style="{StaticResource ToolHint}"/>
                        <WrapPanel>
                            <Button Content="Журнал угроз" Click="Threats_Click" Style="{StaticResource Quiet}"/>
                            <Button Content="Быстрая проверка" Click="Defender_Click" Style="{StaticResource Quiet}"/>
                        </WrapPanel>
                        <TextBlock x:Name="DefenderResult" Style="{StaticResource ToolResult}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource ToolSection}">
                        <TextBlock Text="Диски и корзина" Style="{StaticResource ToolTitle}"/>
                        <ComboBox x:Name="Disks" Style="{StaticResource EditorChoice}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Диск для анализа"/>
                        <WrapPanel>
                            <Button Content="Обновить диски" Click="Disks_Click" Style="{StaticResource Quiet}"/>
                            <Button Content="Анализ места" Click="DiskScan_Click" Style="{StaticResource Quiet}"/>
                            <Button Content="Очистить корзину" Click="Recycle_Click" Style="{StaticResource Quiet}"/>
                        </WrapPanel>
                        <TextBlock x:Name="DiskResult" Style="{StaticResource ToolResult}"/>
                        <TextBlock x:Name="RecycleResult" Style="{StaticResource ToolResult}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource ToolSection}">
                        <TextBlock Text="Быстрый ввод" Style="{StaticResource ToolTitle}"/>
                        <TextBlock Text="Нажмите выбранное ниже сочетание. Введите «открой вк» и нажмите Enter. Escape скрывает окно." Style="{StaticResource ToolHint}"/>
                        <ComboBox x:Name="Shortcut" Style="{StaticResource EditorChoice}" DisplayMemberPath="Label"
                                  SelectionChanged="Shortcut_Changed" AutomationProperties.Name="Глобальная комбинация быстрого ввода"/>
                        <Button Content="Открыть быстрый ввод" Click="Quick_Click" HorizontalAlignment="Left" Style="{StaticResource Quiet}"/>
                        <TextBlock x:Name="ShortcutResult" Style="{StaticResource ToolResult}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Style="{StaticResource ToolSection}">
                        <TextBlock Text="Игровой режим" Style="{StaticResource ToolTitle}"/>
                        <TextBlock Text="Названия EXE игр для учёта времени и приоритета" Style="{StaticResource ToolHint}"/>
                        <Border Style="{StaticResource EditorSurface}">
                            <TextBox x:Name="Games" Style="{StaticResource Field}" TextWrapping="Wrap" MaxLength="1500"
                                     AutomationProperties.Name="Список игр через запятую"/>
                        </Border>
                        <TextBlock Text="Приложения, которые можно закрыть при включении. Укажите EXE через запятую." Style="{StaticResource ToolHint}"/>
                        <Border Style="{StaticResource EditorSurface}">
                            <TextBox x:Name="CloseApps" Style="{StaticResource Field}" TextWrapping="Wrap" MaxLength="1500"
                                     AutomationProperties.Name="Список приложений для закрытия в игровом режиме"/>
                        </Border>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Сохранить списки" Click="GameLists_Click" Style="{StaticResource Quiet}"/>
                            <Button x:Name="GameMode" Content="Включить режим" Click="GameMode_Click" Style="{StaticResource Primary}"/>
                        </WrapPanel>
                        <TextBlock x:Name="GameStatus" Style="{StaticResource ToolResult}"/>
                        <TextBlock Text="Время в играх на этом ПК" Style="{StaticResource ToolHint}" Margin="0,12,0,3"/>
                        <TextBlock x:Name="GameTime" Style="{StaticResource ToolResult}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource ToolSection}">
                        <TextBlock Text="Вывод звука" Style="{StaticResource ToolTitle}"/>
                        <ComboBox x:Name="AudioDevices" Style="{StaticResource EditorChoice}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="Устройство вывода звука"/>
                        <WrapPanel>
                            <Button Content="Обновить" Click="AudioList_Click" Style="{StaticResource Quiet}"/>
                            <Button Content="Переключить" Click="AudioSet_Click" Style="{StaticResource Quiet}"/>
                            <Button Content="Звук Windows" Click="AudioSettings_Click" Style="{StaticResource Quiet}"/>
                        </WrapPanel>
                        <TextBlock x:Name="AudioResult" Style="{StaticResource ToolResult}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource ToolSection}">
                        <TextBlock Text="Интернет" Style="{StaticResource ToolTitle}"/>
                        <TextBlock Text="Хост для пинга. Для проверки игры укажите адрес её сервера." Style="{StaticResource ToolHint}"/>
                        <Border Style="{StaticResource EditorSurface}">
                            <TextBox x:Name="PingHost" Text="1.1.1.1" Style="{StaticResource Field}" MaxLength="255"
                                     AutomationProperties.Name="Хост для пинга"/>
                        </Border>
                        <WrapPanel>
                            <Button Content="Проверить пинг" Click="Ping_Click" Style="{StaticResource Quiet}"/>
                            <Button Content="Проверить скорость" Click="Speed_Click" Style="{StaticResource Quiet}"/>
                        </WrapPanel>
                        <TextBlock x:Name="PingResult" Style="{StaticResource ToolResult}"/>
                        <TextBlock x:Name="SpeedResult" Style="{StaticResource ToolResult}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
